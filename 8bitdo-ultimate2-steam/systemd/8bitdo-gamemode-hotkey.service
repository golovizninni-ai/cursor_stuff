[Unit]
Description=8BitDo Ultimate 2: Start+Select+LB+RB to Game Mode (desktop)
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.local/bin/8bitdo-gamemode-hotkey.py

[Service]
Type=simple
ExecStart=%h/.local/bin/8bitdo-gamemode-hotkey.py
# Не ставить SupplementaryGroups= — user systemd не может менять группы
# (exit 216/GROUP: Operation not permitted). Доступ к event* — через udev TAG+=uaccess.
Restart=on-failure
RestartSec=5
SuccessExitStatus=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
