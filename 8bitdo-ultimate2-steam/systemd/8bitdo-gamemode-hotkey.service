[Unit]
Description=8BitDo Ultimate 2: Guide+LT+RT to Game Mode (desktop)
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.local/bin/8bitdo-gamemode-hotkey.py

[Service]
Type=simple
ExecStart=%h/.local/bin/8bitdo-gamemode-hotkey.py
# user unit не всегда наследует группу input с логина — задаём явно
SupplementaryGroups=input
Restart=on-failure
RestartSec=5
SuccessExitStatus=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
