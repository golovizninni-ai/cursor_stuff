[Desktop Entry]
Type=Application
Version=1.0
Name=GameMode (Monitor)
Name[ru]=Game Mode (Монитор)
Comment=OUTPUT_CONNECTOR=DP-1 → steamosctl switch-to-game-mode
Comment[ru]=Переход в Game Mode на монитор (DP-1). Без sudo.
Icon=steamdeck-gaming-return
Terminal=false
Categories=Game;
# Без pkexec/sudo — на Bazzite 44 нужен steamosctl от пользователя
Exec=bash -c 'mkdir -p "$HOME/.config/environment.d" && printf "OUTPUT_CONNECTOR=DP-1\n" > "$HOME/.config/environment.d/10-gamescope-session.conf" && (command -v steamosctl >/dev/null && steamosctl switch-to-game-mode || systemctl start --user return-to-gamemode.service 2>/dev/null || /usr/bin/return-to-gamemode)'
StartupNotify=false
