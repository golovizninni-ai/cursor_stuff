# Вариант 2: скрыть пустой 2.4 ГГц донгл (PID 6013) от Steam и input-подсистемы.
# USB-устройство остаётся на шине — Wake-on-USB не ломается.
# При включении геймпада в D-Input появляется PID 6012 с нормальными правами.

ACTION=="add", SUBSYSTEM=="input", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="6013", \
  ENV{ID_INPUT}="0", ENV{ID_INPUT_JOYSTICK}="0"

KERNEL=="event*", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="6013", MODE="0000", GROUP="root"
KERNEL=="hidraw*", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="6013", MODE="0000", GROUP="root"
KERNEL=="js*", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="6013", MODE="0000", GROUP="root"
