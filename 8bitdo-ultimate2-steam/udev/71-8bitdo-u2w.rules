# Права hidraw для 8BitDo Ultimate 2 в D-Input (гиро, extended buttons, rumble).
# На Bazzite / SteamOS правила Valve часто уже установлены — этот файл для ручной установки.

# 2.4GHz / Dongle (D-Input PID 6012)
KERNEL=="hidraw*", ATTRS{idProduct}=="6012", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"

# Bluetooth (D-Input)
KERNEL=="hidraw*", KERNELS=="*2DC8:6012*", MODE="0660", TAG+="uaccess"

# Все 8BitDo (альтернатива — если не хотите фильтровать по PID)
# KERNEL=="hidraw*", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"
# KERNEL=="hidraw*", KERNELS=="*2DC8:*", MODE="0660", TAG+="uaccess"
