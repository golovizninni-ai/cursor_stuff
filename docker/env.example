# Скопируется в корень форка как .env (scripts/install-docker.sh).
# SOAP не на 7878 — это порт Radarr в *arr.
# MySQL не на 3306 хоста — часто занят MariaDB *arr.

DOCKER_IMAGE_TAG=local
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_SOAP_EXTERNAL_PORT=127.0.0.1:17878
DOCKER_DB_EXTERNAL_PORT=127.0.0.1:13306
DOCKER_DB_ROOT_PASSWORD=changeme

DOCKER_USER=acore
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000
