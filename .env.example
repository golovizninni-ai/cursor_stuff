# Скопируйте в .env и поправьте. Не коммитьте .env.

# --- сеть хаба ---
# 0.0.0.0 — доступ из LAN. Для только localhost: 127.0.0.1
HUB_BIND=0.0.0.0
WEBUI_PORT=3000
OLLAMA_PORT=11434
LITELLM_PORT=4000
SEARXNG_PORT=8888
COMFYUI_PORT=8188

# Смените оба секрета (install-host.sh генерирует сам).
WEBUI_SECRET_KEY=change-me-please
SEARXNG_SECRET=change-me-please
LITELLM_MASTER_KEY=sk-local-homelab

# Часовой пояс логов
TZ=Europe/Moscow

# --- локальная Ollama (1660 Ti) ---
# 5m — выгрузить веса, чтобы Immich снова мог взять GPU
OLLAMA_KEEP_ALIVE=5m
# Для 7B на 6 ГБ не ставьте 32k
OLLAMA_CONTEXT_LENGTH=4096

# --- воркеры в LAN (пусто = не использовать) ---
# Без слэша на конце, порт 11434
OLLAMA_WORKER_XT=
OLLAMA_WORKER_3060=

# Имена моделей должны совпадать с тем, что pull на воркерах
MODEL_CHAT=qwen2.5:7b
MODEL_CODER=qwen2.5-coder:7b
MODEL_CHAT_SMALL=qwen2.5:3b
MODEL_CODER_SMALL=qwen2.5-coder:3b
# На 9070 XT 16 ГБ, когда воркер жив
MODEL_CHAT_XT=qwen2.5:14b
MODEL_CODER_XT=qwen2.5-coder:14b
