PUID=1000
PGID=1000
TZ=Europe/Moscow
UMASK_SET=002

# Host paths (TrueNAS NFS mount on Ubuntu)
MEDIA_ROOT=/mnt/media
OUTPUT_DIR=${MEDIA_ROOT}/downloads/output
TDARR_TEMP=/opt/tdarr/temp

# Tdarr ports
TDARR_WEBUI_PORT=8265
TDARR_SERVER_PORT=8266

# Local state (not on NFS)
TDARR_SERVER_DIR=./server
TDARR_CONFIGS_DIR=./configs
TDARR_LOGS_DIR=./logs
